{
  "openapi": "3.0.0",
  "info": {
    "title": "Application API",
    "version": "1.0.0",
    "description": "Snapshot generated from Nest Swagger JSON. Run pnpm --filter @repo/api-client generate after API contract changes."
  },
  "paths": {
    "/api/v1/health": {
      "get": { "operationId": "getHealth", "responses": { "200": { "description": "Service health", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Health" } } } } } }
    },
    "/api/v1/me": {
      "get": { "operationId": "getMe", "security": [{ "bearer": [] }], "responses": { "200": { "description": "Current principal", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Principal" } } } }, "401": { "description": "Unauthenticated" } } }
    },

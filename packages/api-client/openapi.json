  "info": {
    "title": "SaaS Application API",
    "description": "Versioned contract used to generate every frontend-to-backend request.",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "Health": {
        "type": "object",
        "properties": {
          "service": {
            "type": "string",
            "enum": ["api"]
          },
          "status": {
            "type": "string",
            "enum": ["ok"]
          }
        },
        "required": ["service", "status"]
      },
      "Principal": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "emailVerified": {
            "type": "boolean"
          },
          "provider": {
            "type": "string"
          },
          "scopes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "userId": {
            "type": "string"
          }
        },
        "required": ["id", "provider", "scopes"]
      },
      "Project": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "organizationId": {
            "type": "string"
          }
        },
        "required": ["id", "name"]
      },
      "ProjectMembership": {
        "type": "object",
        "properties": {
          "project": {
            "$ref": "#/components/schemas/Project"
          },
          "role": {
            "type": "string",
            "enum": ["owner", "admin", "member", "viewer"]
          },
          "userId": {
            "type": "string"
          }
        },
        "required": ["project", "role", "userId"]
      }
    }
  }
}

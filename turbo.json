{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": [".env.example", "apps/*/.env.example"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": [
        "API_URL",
        "CDK_DEFAULT_ACCOUNT",
        "CDK_DEFAULT_REGION",
        "NODE_ENV",
        "NEXT_PUBLIC_API_URL"
      ],
      "outputs": [".next/**", "!.next/cache/**", "cdk.out/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "outputs": []
    },
    "typecheck": {
      "outputs": []
    },
    "test": {
      "outputs": []
    },
    "clean": {
      "cache": false
    }
  }
}


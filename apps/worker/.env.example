# PostgreSQL is the worker's only required durable runtime dependency.
DATABASE_URL=postgresql://app:local-postgres-password@localhost:5432/app
# Or supply complete PGHOST, PGPORT, PGUSER, PGPASSWORD, and PGDATABASE values.
# Bound each task pool for rolling old/new task overlap.
DATABASE_POOL_MAX=6
DATABASE_POOL_IDLE_TIMEOUT_MS=15000
DATABASE_POOL_CONNECTION_TIMEOUT_MS=2500

# Worker-to-API communication remains an authenticated HTTP boundary.
BILLING_PROCESSOR_URL=http://localhost:3001/api/v1/internal/billing/jobs
WORKER_SECRET=local-worker-secret-change-me
BILLING_JOB_POLL_MS=1000
BILLING_JOB_BATCH_SIZE=10
BILLING_JOB_LEASE_MS=60000
BILLING_JOB_MAX_ATTEMPTS=5
BILLING_JOB_RETRY_MS=30000

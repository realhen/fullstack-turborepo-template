NODE_ENV=development
PORT=3001
CORS_ORIGIN=http://localhost:3000

# Keep API documentation available while developing locally.
ENABLE_SWAGGER=true

# Durable local data. Docker Compose supplies the equivalent container URL.
DATABASE_URL=postgresql://app:local-postgres-password@localhost:5432/app
# Or use standard PostgreSQL variables in deployments.
# PGHOST=db.example.internal
# PGPORT=5432
# PGUSER=app
# PGPASSWORD=replace-me
# PGDATABASE=app
# PGSSLMODE=require
# Bound each task so the total across API, worker, migrations, and operators
# remains below PostgreSQL max_connections during a rolling deployment.
DATABASE_POOL_MAX=4
DATABASE_POOL_IDLE_TIMEOUT_MS=15000
DATABASE_POOL_CONNECTION_TIMEOUT_MS=2500
# DATABASE_MIGRATION_URL=postgresql://migration-user:password@localhost:5432/app
# PGSSLMODE=verify-full
# PGSSLROOTCERT=/etc/ssl/certs/rds-global-bundle.pem

# This public development-only token makes `pnpm bootstrap` usable immediately.
# Replace it before sharing a local environment. Local mode is forbidden in production.
AUTH_MODE=local
AUTH_LOCAL_TOKEN=local-development-token-change-me-1234567890
AUTH_LOCAL_SUBJECT=local-developer
# AUTH_LOCAL_EMAIL=developer@example.com
AUTH_LOCAL_SCOPES=profile:read,organizations:read
AUTH_LOCAL_ORGANIZATION_ID=00000000-0000-4000-8000-000000000001
AUTH_LOCAL_ORGANIZATION_NAME=Local organization
AUTH_LOCAL_ORGANIZATION_SLUG=local-org
AUTH_LOCAL_PROJECT_ID=00000000-0000-4000-8000-000000000002
AUTH_LOCAL_PROJECT_NAME=Local project

# For any OIDC-compliant issuer (including Supabase and WorkOS), use:
# AUTH_MODE=oidc
# AUTH_ISSUER=https://issuer.example.com/
# AUTH_AUDIENCE=your-api-audience
# AUTH_CLIENT_ID=your-provider-client-id
# AUTH_JWKS_URI=https://issuer.example.com/.well-known/jwks.json

# Offline billing is the default for local feature development.
BILLING_PROVIDER=local
LOCAL_BILLING_WEBHOOK_SECRET=local-stripe-style-webhook-secret
WORKER_SECRET=local-worker-secret-change-me

# Stripe test/live configuration. The backend resolves these allow-listed
# prices from plan codes; the browser never submits arbitrary Stripe IDs.
# BILLING_PROVIDER=stripe
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_STARTER_MONTHLY=price_...
# STRIPE_PRICE_PRO_MONTHLY=price_...

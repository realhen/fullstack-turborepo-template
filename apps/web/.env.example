# Server-only URL used by Server Components. Use the internal service URL in production.
API_URL=http://localhost:3001

# Server-only bearer token for local/template API calls. Keep this equal to the
# API's AUTH_LOCAL_TOKEN when AUTH_MODE=local. Never expose it as NEXT_PUBLIC.
API_AUTH_TOKEN=local-development-token-change-me-1234567890

# Local mode keeps the template runnable in development and CI. Production requires
# WEB_AUTH_MODE=workos with every WorkOS value below configured in Vercel.
WEB_AUTH_MODE=local
# WORKOS_API_KEY=
# WORKOS_CLIENT_ID=
# Generate with `openssl rand -base64 48`; use 32+ high-entropy characters.
# Repeated or placeholder values are rejected. Keep session/flow cookie names distinct.
# WORKOS_COOKIE_PASSWORD=
# WORKOS_REDIRECT_URI=https://app.example.com/auth/callback
# WORKOS_SESSION_COOKIE_NAME=saas_session
# WORKOS_FLOW_COOKIE_NAME=saas_auth_flow
# WORKOS_SOCIAL_PROVIDERS=GoogleOAuth,MicrosoftOAuth,GitHubOAuth,AppleOAuth
# WORKOS_RADAR_MODE=off
# Required only for WORKOS_RADAR_MODE=log|enforce; must equal WORKOS_CLIENT_ID.
# NEXT_PUBLIC_WORKOS_CLIENT_ID=

# Optional browser-visible base URL for direct client requests.
NEXT_PUBLIC_API_URL=http://localhost:3001

# Optional product analytics. Leave unset to disable PostHog entirely.
# Do not place email addresses, names, tokens, or other PII in analytics events.
# NEXT_PUBLIC_POSTHOG_KEY=phc_example
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

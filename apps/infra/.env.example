CDK_DEFAULT_REGION=us-east-1

# Required CDK context examples. The CDK app does not load this file directly;
# pass these shell values with -c domainName="$DOMAIN_NAME" and
# -c webOrigin="$WEB_ORIGIN".
DOMAIN_NAME=api.example.com
WEB_ORIGIN=https://app.example.com

# Optional CDK context values. Pass them with their lower-camel-case context
# names. The application secret must be a JSON secret
# containing both Stripe secrets and the two configured price IDs listed in
# the root README before enabling Stripe.
# APPLICATION_SECRETS_ARN=arn:aws:secretsmanager:us-east-1:123456789012:secret:my-app
# ALARM_EMAIL=on-call@example.com

# OIDC is enabled only when issuer, JWKS URI, and audience or client ID are set.
# These are generic OIDC context values. Do not put a WorkOS API key, web
# session-cookie password, or any other browser authentication secret in CDK
# context or this file. WorkOS uses AUTH_CLIENT_ID; the API still validates
# tokens through its provider-neutral JWKS adapter.
# AUTH_ISSUER=https://issuer.example.com/
# AUTH_JWKS_URI=https://issuer.example.com/.well-known/jwks.json
# AUTH_AUDIENCE=your-api-audience
# AUTH_CLIENT_ID=your-provider-client-id
